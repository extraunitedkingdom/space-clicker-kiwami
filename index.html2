<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>宇宙開拓クリッカー</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  background:#07111f;
  color:white;
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

.wrap{
  max-width:900px;
  margin:auto;
  padding:16px;
}

h1{
  text-align:center;
}

.card{
  background:#101d31;
  border:1px solid #29415f;
  border-radius:14px;
  padding:14px;
  margin:10px 0;
}

.stats,
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:10px;
}

.stat,
.fac{
  background:#0a1729;
  border-radius:10px;
  padding:11px;
}

.big{
  text-align:center;
  font-size:30px;
  font-weight:800;
}

button{
  width:100%;
  padding:11px;
  margin:4px 0;
  border:0;
  border-radius:10px;
  background:#24517e;
  color:white;
  font-weight:700;
  cursor:pointer;
}

button:disabled{
  opacity:.45;
  cursor:not-allowed;
}

.danger{
  background:#71333d;
}

.good{
  background:#28634d;
}

.small{
  font-size:12px;
  color:#aabbd0;
}

.row{
  display:flex;
  justify-content:space-between;
  gap:8px;
}

#message{
  text-align:center;
  color:#8fd8ff;
  min-height:22px;
  font-weight:700;
}
</style>
</head>

<body>

<div class="wrap">

<h1>🚀 宇宙開拓クリッカー</h1>

<!-- エネルギー -->
<div class="card">

  <div class="big">
    ⚡ <span id="energy">0</span>
  </div>

  <div id="message"></div>

  <button class="good" onclick="clickEnergy()">
    ⚡ エネルギーを集める
  </button>

</div>


<!-- ステータス -->
<div class="card stats">

  <div class="stat">
    🪐 惑星<br>
    <b id="planetName"></b>
  </div>

  <div class="stat">
    🌌 銀河転生<br>
    <b id="rebirthCount"></b>
  </div>

  <div class="stat">
    📈 クリック/回<br>
    <b id="clickPower"></b>
  </div>

  <div class="stat">
    ⏱️ 自動/秒<br>
    <b id="autoPower"></b>
  </div>

  <div class="stat">
    👨‍🚀 探検メンバー<br>
    <b id="members"></b>
  </div>

</div>


<!-- 惑星 -->
<div class="card">

  <h2>🪐 惑星探検</h2>

  <div id="planets"></div>

</div>


<!-- 施設 -->
<div class="card">

  <h2>🏭 現在の惑星のアップグレード</h2>

  <div class="small">
    現在いる惑星の施設だけ表示されます。
  </div>

  <div id="facilities" class="grid"></div>

</div>


<!-- 探検メンバー -->
<div class="card">

  <h2>👨‍🚀 探検メンバー</h2>

  <div class="small">
    メンバー上限 = 5 + 銀河転生回数
  </div>

  <div id="characters" class="grid"></div>

  <button onclick="summonCharacter()">
    🎟️ メンバーを召喚（500⚡）
  </button>

</div>


<!-- 転生 -->
<div class="card">

  <h2>🌌 銀河転生</h2>

  <div id="rebirthInfo" class="small"></div>

  <button onclick="rebirth()">
    🌌 銀河転生する
  </button>

</div>


<!-- セーブ -->
<div class="card">

  <button onclick="saveGame()">
    💾 セーブ
  </button>

  <button onclick="shareGame()">
    📤 共有
  </button>

  <button class="danger" onclick="resetGame()">
    🗑️ データをリセット
  </button>

</div>

</div>


<script>

/* =========================
   セーブデータ
========================= */

const SAVE_KEY = "spaceClickerSave_v6";


/* =========================
   惑星・施設
========================= */

const planets = [

  {
    name:"🌍 地球",
    unlock:0,

    fac:[
      ["🛰️ 宇宙ステーション",10,1,0],
      ["🌙 月面研究所",100,10,0],
      ["🔬 惑星研究センター",1000,50,1],
      ["🚀 軌道開発基地",10000,250,5],
      ["🌐 地球圏エネルギー網",100000,1250,25],
      ["🌌 地球圏開発ステーション",1000000,6250,100]
    ]
  },

  {
    name:"🌙 月",
    unlock:100000,

    fac:[
      ["⛏️ 月面採掘基地",1000,10,1],
      ["🔬 月面研究所",10000,50,5],
      ["🏭 月面資源工場",100000,250,25],
      ["⚡ 月面エネルギー炉",1000000,1250,100],
      ["🛰️ 月面軌道都市",10000000,6250,500],
      ["🌌 月面開発ステーション",100000000,31250,2500]
    ]
  },

  {
    name:"🔴 火星",
    unlock:10000000,

    fac:[
      ["⛏️ 火星採掘基地",100000,20,5],
      ["🔬 火星研究所",1000000,100,25],
      ["🏭 火星資源工場",10000000,500,100],
      ["⚡ 火星エネルギーセンター",100000000,2500,500],
      ["🏙️ 火星都市圏",1000000000,12500,2500],
      ["🌌 火星開発ステーション",10000000000,62500,12500]
    ]
  },

  {
    name:"🟠 木星",
    unlock:1000000000,

    fac:[
      ["🛰️ 木星観測ステーション",10000000,50,50],
      ["🔬 木星研究所",100000000,250,250],
      ["⚡ 木星エネルギー網",1000000000,1250,1000],
      ["🏭 木星資源センター",10000000000,6250,5000],
      ["🌌 木星圏開発基地",100000000000,31250,25000],
      ["🌀 木星超大型開発施設",1000000000000,156250,125000]
    ]
  },

  {
    name:"🪐 土星",
    unlock:100000000000,

    fac:[
      ["🛰️ 土星観測基地",1000000000,100,500],
      ["🔬 土星研究所",10000000000,500,2500],
      ["⚡ 土星エネルギーセンター",100000000000,2500,10000],
      ["🏭 土星資源工場",1000000000000,12500,50000],
      ["🌌 土星環開発基地",10000000000000,62500,250000],
      ["🌀 土星超大型開発施設",100000000000000,312500,1250000]
    ]
  },

  {
    name:"🔵 海王星",
    unlock:10000000000000,

    fac:[
      ["🛰️ 海王星観測基地",100000000000,250,5000],
      ["🔬 海王星研究所",1000000000000,1250,25000],
      ["⚡ 海王星エネルギーセンター",10000000000000,6250,100000],
      ["🏭 海王星資源工場",100000000000000,31250,500000],
      ["🌌 海王星開発ステーション",1000000000000000,156250,2500000],
      ["🌀 海王星超大型開発施設",10000000000000000,781250,12500000]
    ]
  },

  {
    name:"💠 未知の惑星",
    unlock:1000000000000000,

    fac:[
      ["💠 未知資源採掘所",10000000000000,500,50000],
      ["🧪 未知物質研究所",100000000000000,2500,250000],
      ["⚛️ 未知エネルギー炉",1000000000000000,12500,1000000],
      ["🌌 異星文明研究センター",10000000000000000,62500,5000000],
      ["🌀 次元開発基地",100000000000000000,312500,25000000],
      ["🌠 未知宇宙開発施設",1000000000000000000,1562500,125000000]
    ]
  },

  {
    name:"🌌 銀河の中心",
    unlock:100000000000000000,

    fac:[
      ["🌌 銀河観測所",1000000000000000,1000,100000],
      ["🌀 超銀河研究所",10000000000000000,5000,500000],
      ["⚛️ 銀河エネルギー炉",100000000000000000,25000,2000000],
      ["🌠 銀河開発センター",1000000000000000000,125000,10000000],
      ["👑 宇宙創生施設",10000000000000000000,625000,50000000],
      ["✨ 宇宙の果て開発施設",100000000000000000000,3125000,250000000]
    ]
  }

];


/* =========================
   キャラクター
========================= */

const chars = [

  {
    name:"👨‍🚀 新人宇宙飛行士",
    rarity:"N",
    click:1,
    auto:1
  },

  {
    name:"🔧 天才エンジニア",
    rarity:"R",
    click:1.5,
    auto:1.5
  },

  {
    name:"🤖 採掘ロボ・X",
    rarity:"SR",
    click:1,
    auto:3
  },

  {
    name:"👽 未知の異星人",
    rarity:"SR",
    click:2,
    auto:1,
    special:5
  },

  {
    name:"🧑‍🚀 銀河探検家",
    rarity:"SSR",
    click:2.5,
    auto:2
  },

  {
    name:"👑 銀河皇帝",
    rarity:"UR",
    click:4,
    auto:3,
    special:10
  }

];


/* =========================
   ゲーム状態
========================= */

let state = {

  energy:0,

  planet:0,

  rebirth:0,

  facilities:[],

  members:[]

};


/* =========================
   初期化
========================= */

function freshFacilities(){

  return planets.map(
    p => p.fac.map(() => 0)
  );

}

state.facilities = freshFacilities();


/* =========================
   数字表示
========================= */

function formatNumber(n){

  if(!Number.isFinite(n)){
    return "∞";
  }

  if(Math.abs(n) < 1000){
    return Math.floor(n).toLocaleString("ja-JP");
  }

  const units = [
    "",
    "K",
    "M",
    "B",
    "T",
    "Qa",
    "Qi",
    "Sx",
    "Sp",
    "Oc",
    "No",
    "Dc"
  ];

  let x = n;
  let i = 0;

  while(
    Math.abs(x) >= 1000 &&
    i < units.length - 1
  ){
    x /= 1000;
    i++;
  }

  return x.toFixed(
    x < 10 ? 2 :
    x < 100 ? 1 :
    0
  ) + " " + units[i];

}


/* =========================
   探検メンバー上限
========================= */

function memberLimit(){

  return 5 + state.rebirth;

}


/* =========================
   施設価格
   同じ施設を買うたび ×1.18
========================= */

function facilityCost(fi){

  const base =
    planets[state.planet].fac[fi][1];

  const level =
    state.facilities[state.planet][fi] || 0;

  return base * Math.pow(1.18,level);

}


/* =========================
   施設クリック量
=========================

1つ目
↓
普段の倍率 ×2

2つ目
↓
普段の倍率 ÷2

3つ目以降
↓
普段の倍率

普段の倍率 = ×5

つまり

最初 → 次      ×10
次 → 次        ×2.5
その後          ×5
========================= */

function facilityClickValue(fi){

  const base =
    planets[state.planet].fac[fi][2];

  if(fi === 0){

    return base;

  }

  if(fi === 1){

    return base * 10;

  }

  if(fi === 2){

    return base * 25;

  }

  return base * Math.pow(5,fi - 2);

}


/* =========================
   自動生産
========================= */

function facilityAutoValue(fi){

  return planets[state.planet].fac[fi][3];

}


/* =========================
   施設合計
========================= */

function getFacilityClick(){

  let total = 0;

  for(
    let i = 0;
    i < planets[state.planet].fac.length;
    i++
  ){

    total +=
      (state.facilities[state.planet][i] || 0)
      *
      facilityClickValue(i);

  }

  return total;

}


function getFacilityAuto(){

  let total = 0;

  for(
    let i = 0;
    i < planets[state.planet].fac.length;
    i++
  ){

    total +=
      (state.facilities[state.planet][i] || 0)
      *
      facilityAutoValue(i);

  }

  return total;

}


/* =========================
   キャラクター倍率
========================= */

function getCharacterClickMultiplier(){

  return state.members.reduce(
    (total,c) => total * c.click,
    1
  );

}


function getCharacterAutoMultiplier(){

  return state.members.reduce(
    (total,c) => total * c.auto,
    1
  );

}


/* =========================
   転生倍率
========================= */

function rebirthMultiplier(){

  return 1 + state.rebirth * 0.5;

}


/* =========================
   最終クリック
========================= */

function totalClick(){

  return (
    1 + getFacilityClick()
  )
  *
  getCharacterClickMultiplier()
  *
  rebirthMultiplier();

}


function totalAuto(){

  return (
    getFacilityAuto()
  )
  *
  getCharacterAutoMultiplier()
  *
  rebirthMultiplier();

}


/* =========================
   メッセージ
========================= */

function showMessage(text){

  const el =
    document.getElementById("message");

  el.textContent = text;

  clearTimeout(showMessage.timer);

  showMessage.timer =
    setTimeout(() => {

      el.textContent = "";

    },2200);

}


/* =========================
   クリック
========================= */

function clickEnergy(){

  let gain = totalClick();

  for(const c of state.members){

    if(
      c.special &&
      Math.random() < 0.10
    ){

      gain *= c.special;

      showMessage(
        "✨ " +
        c.name +
        "の特殊効果発動！"
      );

    }

  }

  state.energy += gain;

  render();

}


/* =========================
   施設購入
========================= */

function buyFacility(fi){

  const price =
    facilityCost(fi);

  if(state.energy < price){

    showMessage(
      "⚡ エネルギーが足りません"
    );

    return;

  }

  state.energy -= price;

  state.facilities[state.planet][fi]++;

  render();

  saveGame();

}


/* =========================
   惑星開拓
========================= */

function unlockPlanet(pi){

  if(pi !== state.planet + 1){

    showMessage(
      "まず前の惑星を開拓してください"
    );

    return;

  }

  const price =
    planets[pi].unlock;

  if(state.energy < price){

    showMessage(
      "⚡ " +
      formatNumber(price) +
      " 必要です"
    );

    return;

  }

  state.energy -= price;

  state.planet = pi;

  render();

  saveGame();

  showMessage(
    "🎉 " +
    planets[pi].name +
    "を開拓しました！"
  );

}


/* =========================
   メンバー召喚
========================= */

function summonCharacter(){

  if(
    state.members.length >=
    memberLimit()
  ){

    showMessage(
      "👨‍🚀 探検メンバーが上限です"
    );

    return;

  }

  if(state.energy < 500){

    showMessage(
      "⚡ 召喚には500⚡必要です"
    );

    return;

  }

  state.energy -= 500;

  const r =
    Math.random() * 100;

  let character;

  if(r < 1){

    character = chars[5];

  }
  else if(r < 5){

    character = chars[4];

  }
  else if(r < 15){

    character =
      Math.random() < 0.5
      ? chars[2]
      : chars[3];

  }
  else if(r < 40){

    character = chars[1];

  }
  else{

    character = chars[0];

  }

  state.members.push({
    ...character
  });

  render();

  saveGame();

  showMessage(
    "🎉 " +
    character.rarity +
    " " +
    character.name +
    "が加入！"
  );

}


/* =========================
   転生価格
========================= */

function rebirthCost(){

  if(state.rebirth < 1){

    return 100000;

  }

  if(state.rebirth < 3){

    return 100000 *
      Math.pow(3,state.rebirth);

  }

  return 900000 *
    Math.pow(
      10000,
      state.rebirth - 2
    );

}


/* =========================
   銀河転生
========================= */

function rebirth(){

  const price =
    rebirthCost();

  if(state.energy < price){

    showMessage(
      "🌌 転生には " +
      formatNumber(price) +
      "⚡必要です"
    );

    return;

  }

  state.energy = 0;

  state.planet = 0;

  state.facilities =
    freshFacilities();

  /*
    転生するとメンバー枠は増える。
    メンバー自体はリセット。
  */

  state.members = [];

  state.rebirth++;

  render();

  saveGame();

  showMessage(
    "🌌 銀河転生！ " +
    "探検メンバー上限が+1！"
  );

}


/* =========================
   描画
========================= */

function render(){

  document.getElementById("energy")
    .textContent =
    formatNumber(state.energy);

  document.getElementById("planetName")
    .textContent =
    planets[state.planet].name;

  document.getElementById("rebirthCount")
    .textContent =
    state.rebirth + "回";

  document.getElementById("clickPower")
    .textContent =
    formatNumber(totalClick());

  document.getElementById("autoPower")
    .textContent =
    formatNumber(totalAuto());

  document.getElementById("members")
    .textContent =
    state.members.length +
    " / " +
    memberLimit();


  /* =====================
     惑星一覧
  ===================== */

  const planetBox =
    document.getElementById("planets");

  planetBox.innerHTML =
    planets.map((p,i) => {

      const current =
        i === state.planet;

      const next =
        i === state.planet + 1;

      if(current){

        return `
        <div class="card">

          <div class="row">

            <b>${p.name}</b>

            <span>📍現在</span>

          </div>

          <button disabled>
            現在の惑星
          </button>

        </div>
        `;

      }

      if(next){

        return `
        <div class="card">

          <div class="row">

            <b>${p.name}</b>

          </div>

          <button
            onclick="unlockPlanet(${i})"
          >
            開拓：
            ${formatNumber(p.unlock)}⚡
          </button>

        </div>
        `;

      }

      return `
      <div class="card">

        <div class="row">

          <b>${p.name}</b>

          <span>
            ${i < state.planet
              ? "開拓済"
              : "未開拓"}
          </span>

        </div>

        <button disabled>
          ${i < state.planet
            ? "開拓済"
            : "未開拓"}
        </button>

      </div>
      `;

    }).join("");


  /* =====================
     施設
     
     ★重要：
     現在の惑星だけ表示
  ===================== */

  const facilityBox =
    document.getElementById("facilities");

  facilityBox.innerHTML =
    planets[state.planet].fac.map(
      (facility,i) => {

        const level =
          state.facilities
            [state.planet][i] || 0;

        const price =
          facilityCost(i);

        const click =
          facilityClickValue(i);

        const auto =
          facilityAutoValue(i);

        return `
        <div class="fac">

          <h3>
            ${facility[0]}
          </h3>

          <div class="small">
            Lv.${level}
          </div>

          <div>
            クリック
            +${formatNumber(click)}
          </div>

          <div>
            自動
            +${formatNumber(auto)}/秒
          </div>

          <div class="small">
            価格
            ${formatNumber(price)}⚡
          </div>

          <button
            onclick="buyFacility(${i})"
            ${state.energy < price
              ? "disabled"
              : ""}
          >
            購入
          </button>

        </div>
        `;

      }
    ).join("");


  /* =====================
     メンバー
  ===================== */

  const characterBox =
    document.getElementById("characters");

  if(state.members.length === 0){

    characterBox.innerHTML = `
      <div class="small">
        まだ探検メンバーはいません。
      </div>
    `;

  }
  else{

    characterBox.innerHTML =
      state.members.map(c => {

        return `
        <div class="fac">

          <h3>
            ${c.name}
          </h3>

          <div class="small">
            レアリティ：
            ${c.rarity}
          </div>

          <div>
            クリック倍率
            ×${c.click}
          </div>

          <div>
            自動倍率
            ×${c.auto}
          </div>

          ${
            c.special
            ? `
            <div>
              特殊：
              10%でクリック
              ×${c.special}
            </div>
            `
            : ""
          }

        </div>
        `;

      }).join("");

  }


  /* =====================
     転生情報
  ===================== */

  document.getElementById("rebirthInfo")
    .textContent =
      "次の転生：" +
      formatNumber(rebirthCost()) +
      "⚡ / 恒久倍率 ×" +
      rebirthMultiplier().toFixed(1) +
      " / 次のメンバー上限 " +
      (memberLimit() + 1) +
      "人";

}


/* =========================
   セーブ
========================= */

function saveGame(){

  localStorage.setItem(
    SAVE_KEY,
    JSON.stringify(state)
  );

  showMessage(
    "💾 セーブしました"
  );

}


/* =========================
   ロード
========================= */

function loadGame(){

  try{

    const saved =
      localStorage.getItem(
        SAVE_KEY
      );

    if(!saved){

      return;

    }

    const data =
      JSON.parse(saved);

    state = {
      ...state,
      ...data
    };


    /*
      古いデータでも
      施設数を合わせる
    */

    state.facilities =
      planets.map(
        (planet,i) => {

          return planet.fac.map(
            (_,j) => {

              return Number(
                state.facilities?.[i]?.[j] || 0
              );

            }
          );

        }
      );


    if(!Array.isArray(state.members)){

      state.members = [];

    }


    if(
      state.planet < 0 ||
      state.planet >= planets.length
    ){

      state.planet = 0;

    }

  }
  catch(error){

    console.error(
      "セーブデータ読み込みエラー:",
      error
    );

  }

}


/* =========================
   リセット
========================= */

function resetGame(){

  if(
    !confirm(
      "ゲームデータをすべて削除しますか？"
    )
  ){

    return;

  }

  localStorage.removeItem(
    SAVE_KEY
  );

  state = {

    energy:0,

    planet:0,

    rebirth:0,

    facilities:
      freshFacilities(),

    members:[]

  };

  render();

  showMessage(
    "🗑️ データをリセットしました"
  );

}


/* =========================
   共有
========================= */

async function shareGame(){

  const url =
    location.href;

  try{

    if(navigator.share){

      await navigator.share({

        title:
          "宇宙開拓クリッカー",

        text:
          "🚀 宇宙開拓クリッカーで遊ぼう！",

        url:url

      });

    }
    else{

      location.href =
        "https://line.me/R/msg/text/?" +
        encodeURIComponent(
          "🚀 宇宙開拓クリッカーで遊ぼう！ " +
          url
        );

    }

  }
  catch(error){

    console.log(error);

  }

}


/* =========================
   起動
========================= */

loadGame();

render();


/* =========================
   自動生産
========================= */

setInterval(() => {

  const auto =
    totalAuto();

  if(auto > 0){

    state.energy += auto;

    render();

  }

},1000);


/* =========================
   オートセーブ
========================= */

setInterval(() => {

  localStorage.setItem(
    SAVE_KEY,
    JSON.stringify(state)
  );

},5000);

</script>

</body>
</html>